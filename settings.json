{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "Bash(npm run check-types)",
      "Bash(npm run lint *)",
      "Bash(npx eslint *)",
      "Bash(npx stylelint *)",
      "Bash(npx jest *)",
      "Bash(npm test *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(npm run build)",
      "Bash(npm run codegen)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write --check . && npx stylelint --fix '**/*.{css,scss}'",
            "statusMessage": "Format and lint before commit"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "voiceEnabled": false
}
